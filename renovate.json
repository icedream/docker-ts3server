{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended"
	],
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/(^|/|\\.)Dockerfile$/", "/(^|/)Dockerfile[^/]*$/"],
			"matchStrings": ["^(ARG|ENV)\\s+TS3SERVER_VERSION=\"(?<currentValue>.+?)\"", "^(ARG|ENV)\\s+TS3SERVER_VERSION='(?<currentValue>.+?)'"],
			"depNameTemplate": "teamspeak3-server",
			"packageNameTemplate": "nix_unstable/teamspeak-server",
			"datasourceTemplate": "repology"
		}
	],
	"packageRules": [
		{
			"postUpgradeTasks": {
				"commands": [
					".renovate/update-checksum.sh"
				],
				"fileFilters": [
					"Dockerfile",
					"*.Dockerfile"
				],
				"executionMode": "update"
			},
			"matchPackageNames": [
				"/ts3server/"
			]
		}
	]
}
